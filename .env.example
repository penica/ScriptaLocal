# Paths are relative to the project root unless made absolute.
SCRIPTALOCAL_DATA_ROOT=./data
SCRIPTALOCAL_MODEL_ROOT=./data/models
SCRIPTALOCAL_ARTIFACT_ROOT=./data/artifacts
SCRIPTALOCAL_DATABASE_ROOT=./data/postgres
SCRIPTALOCAL_BUILD_CACHE=./data/build-cache
# Temporary local destination; later set this to the mounted Synology NFS path.
# Local restore testing does not establish off-machine disaster recovery.
SCRIPTALOCAL_BACKUP_ROOT=/srv/storage/scriptalocal-backups
SCRIPTALOCAL_BIND_HOST=127.0.0.1
SCRIPTALOCAL_BIND_PORT=8080
# CDI identifiers: each validation container receives exactly one GPU.
SCRIPTALOCAL_GPU_0=nvidia.com/gpu=0
SCRIPTALOCAL_GPU_1=nvidia.com/gpu=1

# Immutable local image ID or registry digest produced by validation.
SCRIPTALOCAL_VALIDATION_IMAGE=
