# Prefer scripts.configure_service; it creates protected local files and pins images.
SCRIPTALOCAL_SERVICE_ROOT=/absolute/path/private/service
SCRIPTALOCAL_MODEL_ROOT=/absolute/path/pinned/model
SCRIPTALOCAL_API_IMAGE=
SCRIPTALOCAL_WORKER_IMAGE=
SCRIPTALOCAL_UID=1000
SCRIPTALOCAL_GID=1000
SCRIPTALOCAL_API_PORT=8090
SCRIPTALOCAL_GPU=nvidia.com/gpu=0
